PIPELINE_TOKEN=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
PART_SEGMENTATION_MODEL=/models/pet_parts.onnx
BACKGROUND_MODEL=birefnet-general
CARTOON_MODEL=stable-diffusion-v1-5/stable-diffusion-v1-5
CONTROLNET_MODEL=lllyasviel/control_v11p_sd15_lineart
# Set only for development experiments; CPU inference cannot meet the 25-second budget.
ALLOW_CPU_INFERENCE=0
