ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://pawsync:pawsync@127.0.0.1:15432/pawsync
REDIS_URL=redis://127.0.0.1:16379/0
LICENSE_PRIVATE_KEY_PATH=data/license-private.pem
# Set PIPELINE_MODE=demo only for explicit placeholder tests.
PIPELINE_MODE=provider
PIPELINE_URL=
PIPELINE_TOKEN=
PADDLE_ENVIRONMENT=sandbox
PADDLE_WEBHOOK_SECRET=
PADDLE_API_KEY=
# Paddle price ids map to server-owned SKUs, never to client-reported balances.
PADDLE_PRICE_CATALOG={"pri_REPLACE_BASE":{"sku":"base"},"pri_REPLACE_5":{"sku":"credits.5"},"pri_REPLACE_15":{"sku":"credits.15"},"pri_REPLACE_40":{"sku":"credits.40"},"pri_REPLACE_HAT":{"sku":"accessory.hat"},"pri_REPLACE_GLASSES":{"sku":"accessory.glasses"}}
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=PawSync <hello@example.com>
SENTRY_DSN=

# Optional Library catalog/paid pet archives. Empty uses the bundled catalog.
LIBRARY_CONTENT_PATH=
LIBRARY_ASSETS_DIR=
# Add configured collection.<id> / accessory.pack.<id> SKUs to PADDLE_PRICE_CATALOG.
